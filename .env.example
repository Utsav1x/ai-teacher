# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
#
#   cp .env.example .env.local
#
# Restart the dev server after any change; Next.js reads these at boot and
# will not hot-reload them.


# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://gphnufrjumkjvblnsstn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdwaG51ZnJqdW1ranZibG5zc3RuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgxODU1MjMsImV4cCI6MjEwMzc2MTUyM30.V-5a0SX5XuxRHF8ccasRW1d76TvTRGnErPm-T47s95s

# Required for material uploads, document indexing and account deletion.
# Dashboard → Settings → API → service_role (the secret one, not anon).
#
# This key bypasses row-level security. Server-side only — never send it to the
# browser, never commit it, never paste it into a chat or issue.
SUPABASE_SERVICE_ROLE_KEY=


# ── AI provider ───────────────────────────────────────────────────────────────
# Free, no credit card: https://aistudio.google.com → Get API key → Create API key
# Used for lesson generation, answer evaluation, embeddings and TTS fallback.

GOOGLE_AI_API_KEY=

# Takes the app off MockTeacherEngine and onto the live AI engine.
# Leave this out and the classroom silently serves hardcoded lessons with no
# error, whatever topic you type. See lib/teacher-engine.ts.
NEXT_PUBLIC_USE_REAL_AI_TEACHER=true

# Optional. The model tried first for generation.
#
# Free-tier quota is granted per model per day and is small — some models allow
# only 20 requests/day. When one is exhausted the provider falls through a chain
# of alternatives automatically, so this is a preference, not a hard dependency.
# Set it if you want a specific model first, or if the default is not available
# to your key.
GEMINI_MODEL=gemini-3.5-flash

# Optional. Which provider implements the AIProvider interface. Only 'gemini'
# exists today, which is the default — set this only when adding another.
# AI_PROVIDER=gemini


# ── Notes ─────────────────────────────────────────────────────────────────────
#
# Narration needs no key. It uses Microsoft Edge neural voices (no quota),
# falling back to Gemini TTS only if those are unreachable.
#
# After filling this in, run all seven files in supabase/migrations/ in
# filename order — see docs/setup.md. Two of them fail silently if skipped:
# retrieval returns nothing while lessons still generate, so the teacher quietly
# stops being grounded in uploaded documents.
